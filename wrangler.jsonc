{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "my-first-website",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": ["ANSWER_SHEET_TOKEN"]
  }
}
